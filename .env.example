# Copy this file to .env and fill in your values.
# .env is never committed to git.

# --- Provider config (required) ---
MODEL_PROVIDER=together
MODEL_API_KEY=your_api_key_here
MODEL_BASE_URL=https://api.together.ai/v1
MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct-Turbo

# --- Sampling (required for reproducibility) ---
MODEL_TEMPERATURE=0.0

# --- Token limits ---
MODEL_MAX_OUTPUT_TOKENS=16384
MODEL_TOKEN_PARAMETER=max_tokens

# --- Retry / timeout ---
MODEL_REQUEST_TIMEOUT=600
MODEL_MAX_RETRIES=3
MODEL_RETRY_SLEEP_SECONDS=10

# --- Optional provider-specific JSON ---
# MODEL_EXTRA_BODY_JSON={"repetition_penalty": 1.1}
